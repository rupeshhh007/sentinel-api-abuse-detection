{
  "title": "Sentinel \u2014 Enforcement operations",
  "uid": "sentinel-ops",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Evaluated requests / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(sentinel_requests_evaluated_total[1m])",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Blocked requests / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(sentinel_requests_blocked_total[1m])",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Storage failures / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(sentinel_redis_failures_total[1m])",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Mean decision latency (ms)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "1000 * rate(sentinel_decision_latency_seconds_sum[1m]) / rate(sentinel_decision_latency_seconds_count[1m])",
          "refId": "A"
        }
      ]
    }
  ]
}